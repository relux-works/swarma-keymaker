    {
      "id": "unknown-member",
      "claim": "Closed root does not acquire extension members; paired root uses the exact member set. Reader verdict PENDING.",
      "negative": {
        "control": "minimal-root",
        "mutation": {
          "kind": "set",
          "member": "unknown",
          "value": true
        },
        "bytes": 1905,
        "sha256": "a5107a9e55720e1ab66ff383f940cf8685f96e7e1698f3df4acc66566828a7aa",
        "expected_rejection": "unknown_member"
      },
      "positive": {
        "golden": "minimal-root",
        "expected": "format-control-only"
      }
    },
    {
      "id": "duplicate-member",
      "claim": "Duplicate decoded names cannot be collapsed into a map; paired canonical root has one version. Reader verdict PENDING.",
      "negative": {
        "control": "minimal-root",
        "mutation": {
          "kind": "duplicate"
        },
        "bytes": 1923,
        "sha256": "f67b26b95d158e9a4372ec705b80afc2aefbad40af678b7de26c91ed03030324",
        "expected_rejection": "duplicate_member"
      },
      "positive": {
        "golden": "minimal-root",
        "expected": "format-control-only"
      }
    },
    {
      "id": "alias-member",
      "claim": "Case aliases do not replace required root_digest; paired spelling is exact. Reader verdict PENDING.",
      "negative": {
        "control": "minimal-root",
        "mutation": {
          "kind": "rename",
          "member": "root_digest",
          "value": "RootDigest"
